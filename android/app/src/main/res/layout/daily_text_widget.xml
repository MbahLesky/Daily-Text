<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Header with badge and date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DAILY TEXT"
            android:textColor="#E0B066"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Scripture Text -->
    <TextView
        android:id="@+id/widget_scripture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textStyle="italic|bold"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- Comment Text -->
    <TextView
        android:id="@+id/widget_comment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:textColor="#E6FFFFFF"
        android:textSize="11.5sp"
        android:lineSpacingExtra="2dp"
        android:maxLines="5"
        android:ellipsize="end" />

    <!-- Tap action footer -->
    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tap to open in JW Library"
        android:textColor="#80FFFFFF"
        android:textSize="9.5sp"
        android:gravity="end" />
</LinearLayout>
