<!--
  Two additions needed in android/app/src/main/AndroidManifest.xml once it
  exists (generated by `flutter create .`). Delete this file after merging.
-->

<!--
  1. Add this <queries> block as a direct child of the top-level <manifest>
     element — a SIBLING of <application>, not inside it. Required on
     Android 11+ (API 30+) package-visibility rules so
     PackageManager.queryIntentActivities() in WidgetTapHandler.kt can
     actually see JW Library's jwpub:// intent filter. Without this, the
     tap handler silently falls back to the browser even when JW Library
     is installed.
-->
<queries>
    <intent>
        <action android:name="android.intent.action.VIEW" />
        <data android:scheme="jwpub" />
    </intent>
</queries>

<!--
  2. Add this <receiver> inside the <application> tag.
-->
<receiver android:name=".DailyTextWidgetProvider" android:exported="true">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
    </intent-filter>
    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/daily_text_widget_info" />
</receiver>
